---
interface Props {
  phone?: string;
  message?: string;
  position?: 'bottom-right' | 'bottom-left';
}

const {
  phone = '',
  message = 'Hola, necesito ayuda.',
  position = 'bottom-right',
} = Astro.props;

const horizontalPosition = position === 'bottom-left' ? 'left-5' : 'right-5';
const tooltipAlignment = position === 'bottom-left' ? 'left-0' : 'right-0';
const href = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
---

<div class={`fixed bottom-5 ${horizontalPosition} z-50`}>
  <span
    class="pointer-events-none absolute inset-0 animate-ping rounded-full bg-emerald-500 opacity-50 motion-reduce:animate-none"
    aria-hidden="true"
  ></span>
  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Contactar por WhatsApp"
    class="group relative flex size-14 items-center justify-center rounded-full bg-emerald-500 text-white shadow-lg transition-transform duration-200 hover:scale-110 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-700"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 32 32"
      class="size-8 fill-current"
      aria-hidden="true"
    >
      <path d="M16.04 3C9.42 3 4.04 8.38 4.04 15c0 2.12.56 4.19 1.62 6L4 27l6.16-1.62A11.95 11.95 0 0 0 16.04 27C22.66 27 28.04 21.62 28.04 15S22.66 3 16.04 3Zm0 21.8c-1.84 0-3.64-.5-5.2-1.44l-.38-.22-3.66.96.98-3.56-.24-.4A9.77 9.77 0 0 1 6.04 15c0-5.52 4.49-10 10-10 5.52 0 10 4.48 10 10s-4.48 9.8-10 9.8Zm5.49-7.49c-.3-.15-1.77-.87-2.05-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.95 1.17-.18.2-.35.22-.65.07-.3-.15-1.27-.47-2.42-1.5-.9-.8-1.5-1.78-1.68-2.08-.18-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.08-.8.37-.27.3-1.04 1.02-1.04 2.49s1.07 2.89 1.22 3.09c.15.2 2.1 3.2 5.08 4.49.71.31 1.27.5 1.7.64.71.23 1.36.2 1.87.12.57-.08 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35Z" />
    </svg>
  </a>
  <div
    id="whatsapp-bubble"
    class={`absolute bottom-full ${tooltipAlignment} mb-3 flex w-max items-center gap-2 rounded-xl bg-[#DDC8A8] py-2 pl-4 pr-2 text-sm font-medium text-ink shadow-lg`}
  >
    <span>Ordenar domicilio</span>
    <button
      id="whatsapp-bubble-close"
      type="button"
      aria-label="Cerrar mensaje"
      class="flex size-6 shrink-0 items-center justify-center rounded-full bg-ink text-paper transition-colors hover:bg-ink/80 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
    >
      <svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6 6 18" />
      </svg>
    </button>
  </div>
</div>

<script>
  document.querySelector('#whatsapp-bubble-close')?.addEventListener('click', () => {
    document.querySelector('#whatsapp-bubble')?.remove();
  });
</script>