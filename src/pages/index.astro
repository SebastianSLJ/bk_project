---
import Layout from '../layouts/Layout.astro';
import logoImage from '../images/45.png';
import { Image } from 'astro:assets';
import heroMain from '../images/hero-main.jpg';      // vertical, ej. pan/croissants
import heroTop from '../images/hero-croissant.jpg';  // cuadrada
import heroBottom from '../images/hero-cafe.jpg';




const brand = 'Bukë';
const announcement = 'Una buena mañana empieza con algo recién horneado';

const menu = [
  { id: 'desayunos', label: 'Desayuno', icon: 'sunrise' },
  { id: 'almuerzos', label: 'Almuerzo', icon: 'lunch' },
  { id: 'cafe', label: 'Tarde', icon: 'coffee' },
];

const bakery = [
  { name: 'Nombre', note: 'Descripción', bg: 'bg-wheat text-ink', span: 'md:col-span-2 h-72' },
  { name: 'Nombre', note: 'Descripción', bg: 'bg-crust text-paper', span: 'h-72' },
  { name: 'Nombre', note: 'Descripción', bg: 'bg-paper text-ink', span: 'h-56' },
  { name: 'Nombre', note: 'Descripción', bg: 'bg-wheat text-ink', span: 'md:col-span-2 h-56' },
];

const celebrationFeatures = [
  { label: 'Terraza al aire libre', icon: 'terrace' },
  { label: 'Panadería recién horneada', icon: 'bread' },
  { label: 'Atención personalizada', icon: 'service' },
  { label: 'Ideal para grupos y eventos', icon: 'groups' },
];

const icons = {
  sunrise: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4 18h16"/>',
  lunch: '<path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20m14-7V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>',
  coffee: '<path d="M10 2v2m4-2v2M4 8h15v8a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4V8Zm15 2h1a2 2 0 1 1 0 4h-1M2 22h20"/>',
  terrace: '<path d="M3 11h18L12 3 3 11Zm9 0v10m-5 0h10M5 11l-2 10m16-10 2 10"/>',
  bread: '<path d="M3 10c0-3.3 4-6 9-6s9 2.7 9 6v8H3v-8Zm0 3h18m-13-3v2m4-3v2m4-2v2"/>',
  service: '<circle cx="9" cy="7" r="3"/><path d="M3 20v-1a6 6 0 0 1 12 0v1m2-9h5l-2 4h-3l-2-4Zm2 4v2"/>',
  groups: '<circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M2 20v-1a7 7 0 0 1 14 0v1m1-5a5 5 0 0 1 5 5"/>',
  menu: '<path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>',
  delivery: '<circle cx="18.5" cy="17.5" r="3.5"/><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="M12 17.5V14l-3-3 4-3 2 3h2"/>',
  clock: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
  pin: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>',
};


const sede = {
  name: 'Bukë Chía',
  address: 'Km 2, Chía, Cundinamarca', // TODO: dirección real
  hours: [
    { days: 'Lunes a Jueves', time: '7:00 a.m. a 7:00 p.m.' },
    { days: 'Viernes y Sábado', time: '7:00 a.m. a 8:00 p.m.' }, 
    { days: 'Domingos', time: '7:00 a.m. a 7:00 p.m.' }       
  ],
  coords: '4.880245114039746, -74.03748474639707',         // Coordenadas google Maps
  whatsapp: '57XXXXXXXXXX',  // TODO: número con indicativo, sin + ni espacios
};
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${sede.coords}`;

const quick = [
  { label: 'Ver menú', href: '/menu', icon: 'menu' },
  { label: 'Domicilios', href: '#', icon: 'delivery', external: true }, // TODO: link real de pedidos
  { label: 'Horarios', href: '#ubicacion', icon: 'clock' },
  { label: 'Cómo llegar', href: mapsUrl, icon: 'pin', external: true },
];

const primaryActions = quick.slice(0, 2);   // Ver menú, Domicilios
const secondaryActions = quick.slice(2);    // Horarios, Cómo llegar



const btn = 'inline-flex items-center rounded-full px-6 py-3 font-medium';
---
<Layout title={`${brand} | Panadería, café y repostería en Bogotá`} description="Pan de masa madre, café y repostería hechos cada día. Reserva tu mesa o pide para llevar.">
  <header class="sticky top-0 z-30 border-b border-ink/10 bg-paper text-ink">
    <div class="announcement-ribbon hidden sm:block" role="region" aria-label={announcement}>
      <div class="announcement-track" aria-hidden="true">
        {Array.from({ length: 2 }).map(() => (
          <div class="announcement-group">
            {Array.from({ length: 4 }).map(() => (
              <span class="announcement-item">{announcement}</span>
            ))}
          </div>
        ))}
      </div>
    </div>
    <nav class="relative mx-auto flex min-h-16 md:min-h-24 max-w-6xl items-center justify-between px-4 py-2 md:px-6" aria-label="Principal">
      <div class="relative flex min-w-0 items-center justify-self-start">
        <button id="mobile-menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="primary-menu" class="flex size-11 shrink-0 items-center justify-center rounded-full transition-colors hover:bg-ink/10">
          <span class="flex w-5 flex-col gap-1.5" aria-hidden="true">
            <span class="h-0.5 w-full bg-current"></span>
            <span class="h-0.5 w-full bg-current"></span>
            <span class="h-0.5 w-full bg-current"></span>
          </span>
        </button>
        <ul 
          id="primary-menu" 
          class="absolute left-0 top-[calc(100%+0.75rem)] z-40 hidden min-w-52 flex-col gap-1 rounded-lg border border-ink/10 bg-paper p-2 text-ink shadow-lg"
        >
          <li><a href="/menu" class="block rounded px-4 py-3 hover:bg-ink/10">Menú</a></li>
          <li><a href="#panaderia" class="block rounded px-4 py-3 hover:bg-ink/10">Panadería</a></li>
        </ul>
      </div>
      <!-- image logo -->
      <a href="#" aria-label={brand} class="absolute left-1/2 top-1/2 flex h-auto w-20 -translate-x-1/2 -translate-y-1/2 items-center justify-center md:w-35">
      <Image src={logoImage} alt={brand} class="block h-auto w-full object-contain" />
      </a>
      <a href="#" aria-label="Ver menú" class="inline-flex min-h-11 items-center rounded-full bg-ink px-2 py-2 text-xs font-medium text-paper sm:px-5 sm:text-base">Domicilios</a>
    </nav>
  </header>

  <main>
  <section class="bg-wheat">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 pt-8 pb-14 sm:px-6 md:grid-cols-[5fr_7fr] md:gap-16 md:py-16">
    <div>
      <h1 class="max-w-md font-display text-[clamp(2.75rem,9vw,4.5rem)] leading-[0.98] font-semibold tracking-[-0.045em]">
        <span class="block">Tu desayuno,</span>
        <span class="block">recién hecho</span>
        <span class="block">y sin afán.</span>
      </h1>
      <p class="mt-5 max-w-sm text-lg text-ink/80">
        Descripción
      </p>

      <nav aria-label="Accesos rápidos" class="mt-8 max-w-md">
        <ul class="flex flex-col gap-3 sm:flex-row">
          {primaryActions.map((q, i) => (
            <li class="sm:flex-1">
              <a
                href={q.href}
                {...(q.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                class={`flex min-h-14 items-center justify-center gap-2.5 rounded-full px-6 font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink active:opacity-80 ${
                  i === 0 ? 'bg-ink text-paper' : 'border-2 border-ink hover:bg-ink hover:text-paper'
                }`}
              >
                <svg class="size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[q.icon]} />
                {q.label}
              </a>
            </li>
          ))}
        </ul>

        <ul class="mt-3 grid grid-cols-2 gap-3 md:mt-6 md:flex md:gap-6 md:border-t md:border-ink/15 md:pt-3">
          {secondaryActions.map((q) => (
            <li>
              <a
                href={q.href}
                class="flex min-h-12 items-center justify-center gap-1.5 rounded-xl border-[1.5px] border-ink px-2.5 text-sm font-medium whitespace-nowrap transition-colors active:bg-ink/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink md:inline-flex md:min-h-11 md:justify-start md:gap-2 md:rounded-none md:border-0 md:px-0 md:underline-offset-4 md:hover:underline md:active:bg-transparent"
              >
                <svg class="size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[q.icon]} />
                {q.label}
                <svg class="size-4 shrink-0 md:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="grid h-80 grid-cols-2 grid-rows-2 gap-3 md:h-[30rem] md:gap-4">
      <Image src={heroMain} alt="Pan de masa madre recién salido del horno" loading="eager" class="row-span-2 h-full w-full rounded-2xl object-cover" />
      <Image src={heroTop} alt="Croissant de mantequilla" class="h-full w-full rounded-2xl object-cover" />
      <Image src={heroBottom} alt="Café filtrado" class="h-full w-full rounded-2xl object-cover" />
    </div>
  </div>
</section>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    .hero-arch-img {
      animation: arch-rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
  }
  @keyframes arch-rise {
    from { clip-path: inset(100% 0 0 0); }
    to { clip-path: inset(0); }
  }
</style>



    <!-- Cinta Opciones de comida -->
    <section id="menu" class="mx-auto max-w-6xl px-6 py-8 md:py-14">
      <h2 class="text-center font-display text-3xl font-semibold tracking-tight md:text-5xl">¿Qué se te antoja ahora?</h2>
      <nav aria-label="Explorar el menú por momento del día" class="mt-8 flex flex-wrap justify-center gap-2">
        {menu.map((m, i) => (
          <a href={`/menu#${m.id}`} class="flex min-h-11 items-center justify-center gap-2 rounded-full border-2 border-ink px-5 py-2 font-medium transition-colors hover:bg-ink hover:text-paper">
            <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[m.icon]} />
            {m.label}
          </a>
        ))}
      </nav>
    </section>

    <!-- Panadería: reemplaza los bloques de color por fotos con <Image /> de astro:assets -->
    <section id="panaderia" class="bg-ink py-10 text-paper md:py-16">
      <div class="mx-auto max-w-6xl px-6">
        <h2 class="font-display max-w-2xl text-3xl font-semibold tracking-tight md:text-5xl">Favoritos de Bukë</h2>
        <div class="mt-12 grid gap-4 md:grid-cols-3">
          {bakery.map((b) => (
            <div class={`flex items-end rounded-2xl p-6 ${b.bg} ${b.span}`}>
              <div>
                <h3 class="font-display text-2xl font-semibold">{b.name}</h3>
                <p class="opacity-80">{b.note}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Celebraciones -->
    <section id="celebraciones" class="bg-paper py-14 md:py-12">
      <div class="mx-auto grid max-w-6xl items-center gap-10 px-6 md:grid-cols-[0.9fr_1.1fr] md:gap-12">
        <div>
          
          <h2 class="font-display max-w-xl text-4xl leading-tight font-semibold tracking-tight md:text-5xl">
            Celebra tus mejores momentos en Bukë
          </h2>
          <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink/80">
            Cumpleaños, reuniones familiares, encuentros de amigos o reuniones de trabajo. En Bukë encontrarás un espacio cálido para compartir, con panadería recién horneada, platos artesanales y atención cercana.
          </p>

          <a href="#ubicacion" class="mt-7 inline-flex min-h-14 items-center justify-center gap-4 rounded-full bg-ink px-7 font-medium text-paper transition-colors hover:bg-ink/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink">
            <svg class="size-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="5" width="18" height="16" rx="2" />
              <path d="M16 3v4M8 3v4M3 11h18" />
            </svg>
            Reservar
            <svg class="size-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m9 18 6-6-6-6" />
            </svg>
          </a>

          <ul class="mt-8 grid grid-cols-2 gap-x-4 gap-y-5 border-t border-ink/20 pt-6 sm:grid-cols-4 md:gap-3">
            {celebrationFeatures.map((feature) => (
              <li class="flex flex-col items-center gap-2 text-center text-xs font-medium leading-snug sm:text-sm">
                <svg class="size-8 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[feature.icon]} />
                <span>{feature.label}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="grid aspect-[1/1.05] grid-cols-2 grid-rows-[1.1fr_1fr] gap-3 sm:gap-4 md:aspect-auto md:h-[34rem]">
          <figure class="relative col-span-2 overflow-hidden rounded-2xl">
            <Image src={heroBottom} alt="Variedad de panadería artesanal recién horneada" class="h-full w-full object-cover" />
            
          </figure>
          <figure class="relative overflow-hidden rounded-2xl">
            <Image src={heroMain} alt="Pan de banano preparado para compartir" class="h-full w-full object-cover" />
            
          </figure>
          <figure class="relative overflow-hidden rounded-2xl">
            <Image src={heroTop} alt="Rollos de canela para acompañar una reunión" class="h-full w-full object-cover" />
            
          </figure>
        </div>
      </div>
    </section>

    <!-- Divisor -->
    <div class="mx-auto flex max-w-6xl items-center gap-4 px-6" role="separator" aria-hidden="true">
      <span class="h-px flex-1 bg-ink/20"></span>
      <svg class="size-6 shrink-0 text-ink/40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10c0-3.3 4-6 9-6s9 2.7 9 6v8H3v-8Zm0 3h18m-13-3v2m4-3v2m4-2v2" /></svg>
      <span class="h-px flex-1 bg-ink/20"></span>
    </div>

    <!-- Sedes y reservas -->
    <section id="ubicacion" class="mx-auto max-w-6xl scroll-mt-28 px-6 py-10 md:py-14">
  <h2 class="font-display text-3xl font-semibold tracking-tight md:text-5xl">Encuéntranos en Chía</h2>

  <div class="mt-10 grid gap-8 md:grid-cols-[1fr_1.2fr] md:gap-12">
    <div>
      <h3 class="font-display text-2xl font-semibold">{sede.name}</h3>
      <p class="mt-2 text-ink/70">{sede.address}</p>

      <dl class="mt-6 divide-y divide-ink/20 border-y border-ink/20">
        {sede.hours.map((h) => (
          <div class="flex items-baseline justify-between gap-4 py-3">
            <dt class="text-ink/70">{h.days}</dt>
            <dd class="font-medium whitespace-nowrap">{h.time}</dd>
          </div>
        ))}
      </dl>

      <div class="mt-6 grid grid-cols-2 gap-3 md:flex">
        <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class={`${btn} min-h-12 justify-center bg-ink text-paper`}>
          Cómo llegar
        </a>
        <a
          href={`https://wa.me/${sede.whatsapp}?text=${encodeURIComponent('Hola, quiero reservar una mesa en Bukë Chía.')}`}
          target="_blank"
          rel="noopener noreferrer"
          class={`${btn} min-h-12 justify-center border-2 border-ink`}
        >
          Reservar
        </a>
      </div>
    </div>

    <iframe
      src={`https://www.google.com/maps?q=${sede.coords}&output=embed`}
      title="Mapa de Bukë en Chía"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      class="pointer-events-none h-72 w-full rounded-2xl border-0 md:pointer-events-auto md:h-full md:min-h-96 md:-translate-y-16"
    ></iframe>
  </div>
</section>

  </main>

  <footer class="bg-ink text-paper">
    <div class="mx-auto flex max-w-6xl flex-col gap-6 px-6 py-10 md:flex-row md:items-center md:justify-between">
      <p class="font-display text-2xl font-bold">{brand}</p>
      <ul class="flex items-center gap-3">
        <li>
          <a href="#" class="inline-flex min-h-11 items-center gap-2 rounded-full border border-paper/30 px-5 text-sm font-medium text-paper/90 transition-colors hover:border-paper hover:bg-paper hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-paper">
            <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" /></svg>
            Instagram
          </a>
        </li>
        <li>
          <a href="#" class="inline-flex min-h-11 items-center gap-2 rounded-full border border-paper/30 px-5 text-sm font-medium text-paper/90 transition-colors hover:border-paper hover:bg-paper hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-paper">
            <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
            Contacto
          </a>
        </li>
      </ul>
      <p class="text-sm text-paper/60">© {new Date().getFullYear()} {brand}. Chía, Colombia.</p>
    </div>
  </footer>
</Layout>

<script>
  const menuToggle = document.querySelector<HTMLButtonElement>('#mobile-menu-toggle');
  const primaryMenu = document.querySelector<HTMLUListElement>('#primary-menu');

  const closeMenu = () => {
    primaryMenu?.classList.add('hidden');
    menuToggle?.setAttribute('aria-expanded', 'false');
    menuToggle?.setAttribute('aria-label', 'Abrir menú');
  };

  menuToggle?.addEventListener('click', () => {
    const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
    menuToggle.setAttribute('aria-expanded', String(!isExpanded));
    menuToggle.setAttribute('aria-label', isExpanded ? 'Abrir menú' : 'Cerrar menú');
    primaryMenu?.classList.toggle('hidden', isExpanded);
  });

  primaryMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });

</script>
