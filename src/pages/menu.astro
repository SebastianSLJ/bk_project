---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import ProductCard from '../components/ProductCard.astro';
import { categorias } from '../data/categorias.mjs';
import logoImage from '../images/45.png';
const brand = 'Bukë';
const announcement = ['Pan artesanal', 'Desayunos', 'Almuerzos', 'Repostería'];
const announcementLabel = announcement.join(', ');

const disponibles = (await getCollection('productos', ({ data }) => data.disponible)).map((p) => p.data);

const esAdicion = (nombre: string) => /^adici[oó]n/i.test(nombre);

// Orden dentro de una categoría: primero los ids de `orden` (en ese orden), luego el resto (orden del JSON)
// y, si `adicionesAlFinal`, las adiciones no listadas al final. Ver src/data/categorias.mjs.
function ordenar<T extends { id: string; nombre: string }>(
  c: { id: string; orden?: string[]; adicionesAlFinal?: boolean },
  items: T[],
): T[] {
  const orden = c.orden ?? [];
  for (const id of orden) {
    if (!items.some((p) => p.id === id)) console.warn(`[menu] "${id}" está en el orden de "${c.id}" pero no existe o no pertenece a esa categoría.`);
  }
  const rank = (p: T) => {
    const i = orden.indexOf(p.id);
    if (i !== -1) return i;
    return orden.length + (c.adicionesAlFinal && esAdicion(p.nombre) ? 1 : 0);
  };
  return [...items].sort((a, b) => rank(a) - rank(b)); // sort estable
}

// Una sección por categoría (un producto puede estar en varias); se omiten las vacías.
const products = categorias
  .map((c) => ({
    id: c.id,
    title: c.label,
    description: c.description,
    icon: c.icon,
    items: ordenar(c, disponibles.filter((p) => p.categorias.includes(c.id))),
  }))
  .filter((c) => c.items.length > 0);

const categories = products.map(({ id, title, icon }) => ({ id, label: title, icon }));

const categoryIcons: Record<string, string> = {
  drink: '<path d="M5 3h14l-1.5 17a1 1 0 0 1-1 1h-9a1 1 0 0 1-1-1L5 3Zm.5 5h13"/>',
  bread: '<path d="M3 10c0-3.3 4-6 9-6s9 2.7 9 6v8H3v-8Zm0 3h18m-13-3v2m4-3v2m4-2v2"/>',
  sunrise: '<circle cx="12" cy="12" r="5"/><path d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.72 12.72 1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42m12.72-12.72 1.42-1.42"/>',
  lunch: '<path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20m14-7V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>',
  coffee: '<path d="M10 2v2m4-2v2M4 8h15v8a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4V8Zm15 2h1a2 2 0 1 1 0 4h-1M2 22h20"/>',
  dessert: '<path d="M4 10h16l-2 10H6L4 10Zm-1 0a9 9 0 0 1 18 0M12 2v2m-5 0 1 2m9-2-1 2"/>',
};
---

<Layout
  title="Menú | Bukë, artesanos del pan"
  description="Explora el menú de Bukë: panadería artesanal, desayunos, almuerzos, café y postres."
>
  <header class="relative z-40 border-b border-ink/10 bg-paper text-ink shadow-[0_2px_8px_rgba(0,0,0,0.08)]">
    <div class="announcement-ribbon" role="region" aria-label={announcementLabel}>
      <div class="announcement-track" aria-hidden="true">
        {Array.from({ length: 4 }).map(() => (
          <div class="announcement-group">
            {announcement.map((item) => (
              <span class="announcement-item">{item}</span>
            ))}
          </div>
        ))}
      </div>
    </div>
    <nav class="relative mx-auto flex min-h-16 md:min-h-24 max-w-6xl items-center justify-between px-4 py-2 md:px-6" aria-label="Principal">
      <div class="relative flex min-w-0 items-center justify-self-start">
        <button id="mobile-menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="primary-menu" class="flex size-11 shrink-0 items-center justify-center rounded-full transition-colors hover:bg-ink/10">
          <span class="flex w-5 flex-col gap-1.5" aria-hidden="true">
            <span class="h-0.5 w-full bg-current"></span>
            <span class="h-0.5 w-full bg-current"></span>
            <span class="h-0.5 w-full bg-current"></span>
          </span>
        </button>
        <ul
          id="primary-menu"
          class="absolute left-0 top-[calc(100%+0.75rem)] z-40 hidden min-w-52 flex-col gap-1 rounded-lg border border-ink/10 bg-paper p-2 text-ink shadow-lg"
        >
          <li><a href="/menu" class="block rounded px-4 py-3 hover:bg-ink/10">Menú</a></li>
          <li><a href="/#panaderia" class="block rounded px-4 py-3 hover:bg-ink/10">Panadería</a></li>
        </ul>
      </div>
      <a href="/" aria-label={brand} class="absolute left-1/2 top-1/2 flex h-auto w-20 -translate-x-1/2 -translate-y-1/2 items-center justify-center md:w-35">
        <Image src={logoImage} alt={brand} class="block h-auto w-full object-contain" />
      </a>
      <a href="/#ubicacion" class="inline-flex min-h-11 items-center rounded-full bg-ink px-2 py-2 text-xs font-medium text-paper sm:px-5 sm:text-base">Visítanos</a>
    </nav>
  </header>

  <nav aria-label="Categorías del menú" class="sticky top-0 z-30 border-b border-ink/25 bg-paper/95 shadow-sm backdrop-blur">
    <ul class="category-scroll mx-auto flex max-w-6xl gap-2 overflow-x-auto px-4 py-3 sm:gap-3 sm:px-6 [&>li:first-child]:ml-auto [&>li:last-child]:mr-auto">
      {categories.map((category) => (
        <li class="shrink-0">
          <a
            href={`#${category.id}`}
            data-category-tab={category.id}
            aria-current="false"
            class="inline-flex min-h-11 w-40 items-center justify-center gap-2 rounded-full border border-ink/25 px-4 text-sm font-medium transition-colors hover:bg-ink hover:text-paper focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
          >
            <span class="flex size-7 items-center justify-center rounded-full border border-current">
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={categoryIcons[category.icon]} />
            </span>
            {category.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <main id="top" class="mx-auto max-w-6xl px-5 pb-20 pt-10 sm:px-6 sm:pt-14">
    <div class="mb-12 text-center sm:mb-16">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-clay">Mensaje</p>
      <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight sm:text-5xl md:text-6xl">Nuestro menú</h1>
      <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-ink/75 sm:text-lg">
        Descripción (Tentativa)
      </p>
      
    </div>

    <div>
      {products.map((category, index) => (
        <section id={category.id} data-category-panel aria-labelledby={`${category.id}-title`} class:list={['scroll-mt-28', index !== 0 && 'hidden']}>
          <div class="mb-6 flex flex-wrap items-end justify-between gap-3 border-b border-ink/20 pb-4 sm:mb-8">
            <div>
              <h2 id={`${category.id}-title`} class="font-display text-3xl font-semibold tracking-tight sm:text-4xl">
                {category.title}
              </h2>
              <p class="mt-2 text-sm text-ink/70 sm:text-base">{category.description}</p>
            </div>
            <a href="#top" class="text-sm font-medium underline decoration-ink/40 underline-offset-4 hover:decoration-ink">
              Volver arriba
            </a>
          </div>

          <ul class="grid grid-cols-2 gap-4 sm:gap-5 lg:grid-cols-3">
            {category.items.map((product) => (
              <ProductCard nombre={product.nombre} precio={product.precio} descripcion={product.descripcion} imagen={product.imagen as ImageMetadata | undefined} />
            ))}
          </ul>
        </section>
      ))}
    </div>
  </main>

</Layout>

<script>
  const menuToggle = document.querySelector<HTMLButtonElement>('#mobile-menu-toggle');
  const primaryMenu = document.querySelector<HTMLUListElement>('#primary-menu');

  const closeMenu = () => {
    primaryMenu?.classList.add('hidden');
    menuToggle?.setAttribute('aria-expanded', 'false');
    menuToggle?.setAttribute('aria-label', 'Abrir menú');
  };

  menuToggle?.addEventListener('click', () => {
    const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
    menuToggle.setAttribute('aria-expanded', String(!isExpanded));
    menuToggle.setAttribute('aria-label', isExpanded ? 'Abrir menú' : 'Cerrar menú');
    primaryMenu?.classList.toggle('hidden', isExpanded);
  });

  primaryMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });

  const tabs = document.querySelectorAll<HTMLAnchorElement>('[data-category-tab]');
  const panels = document.querySelectorAll<HTMLElement>('[data-category-panel]');

  const showCategory = (id: string) => {
    const target = Array.from(panels).some((p) => p.id === id) ? id : panels[0]?.id;
    panels.forEach((p) => p.classList.toggle('hidden', p.id !== target));
    tabs.forEach((t) => {
      const active = t.dataset.categoryTab === target;
      t.setAttribute('aria-current', String(active));
      t.classList.toggle('bg-ink', active);
      t.classList.toggle('text-paper', active);
    });
  };

  tabs.forEach((tab) =>
    tab.addEventListener('click', (event) => {
      event.preventDefault();
      const id = tab.dataset.categoryTab!;
      history.replaceState(null, '', `#${id}`);
      showCategory(id);
      document.getElementById('top')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    })
  );

  window.addEventListener('hashchange', () => showCategory(location.hash.slice(1)));
  showCategory(location.hash.slice(1));
</script>

<style>
  .category-scroll {
    scrollbar-width: none;
  }

  .category-scroll::-webkit-scrollbar {
    display: none;
  }
</style>
